{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de Productos Mejora 2",
  "description": "Esquema de validación para el catálogo de productos con códigos de barras de distintos formatos (EAN-8, UPC-12, EAN-13, ITF-14).",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "description": "Metadatos sobre la generación del catálogo (fecha, fuente, filtros, etc.).",
      "additionalProperties": true
    },
    "productos": {
      "type": "array",
      "description": "Lista de productos en el catálogo.",
      "items": {
        "type": "object",
        "properties": {
          "ean": {
            "type": "string",
            "description": "Código de barras. Acepta entre 8 y 14 dígitos (EAN-8, UPC-12, EAN-13, ITF-14).",
            "pattern": "^[0-9]{8,14}$"
          },
          "descripcion": {
            "type": "string",
            "description": "Nombre o descripción del producto.",
            "minLength": 1
          },
          "marca": {
            "type": "string",
            "description": "Marca del producto."
          },
          "categoria": {
            "type": "string",
            "description": "Categoría del producto (puede estar vacía)."
          },
          "dias_caducidad": {
            "type": "number",
            "description": "Días estimados de caducidad."
          }
        },
        "required": ["ean", "descripcion"],
        "additionalProperties": true
      }
    }
  },
  "required": ["productos"],
  "additionalProperties": true
}
