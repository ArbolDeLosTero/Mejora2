{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de Productos Mejora 2",
  "description": "Esquema de validación para el catálogo de productos con códigos de barras EAN-13.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "description": "Metadatos sobre la generación del catálogo (fecha, fuente, filtros, etc.).",
      "additionalProperties": true
    },
    "productos": {
      "type": "array",
      "description": "Lista de productos en el catálogo.",
      "items": {
        "type": "object",
        "properties": {
          "ean": {
            "type": "string",
            "description": "Código de barras EAN-13. Debe contener exactamente 13 dígitos numéricos.",
            "pattern": "^[0-9]{13}$"
          },
          "descripcion": {
            "type": "string",
            "description": "Nombre o descripción del producto.",
            "minLength": 1
          },
          "marca": {
            "type": "string",
            "description": "Marca del producto."
          },
          "categoria": {
            "type": "string",
            "description": "Categoría del producto (puede estar vacía)."
          },
          "dias_caducidad": {
            "type": "number",
            "description": "Días estimados de caducidad."
          }
        },
        "required": [
          "ean",
          "descripcion"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "productos"
  ],
  "additionalProperties": true
}
