# archivo distinto sin tocar firestore.rules).
# firestore.indexes.json afecta qué queries son válidas en
# runtime (un cambio rompe B11/B15/B16 si no se revisa).
# ------------------------------------------------------------
/firestore.rules                        @ArbolDeLosTero
/firestore.indexes.json                 @ArbolDeLosTero
